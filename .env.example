# GEMINI_API_KEY: Optional for on-demand Gemini AI research brief synthesis.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# PUMPPORTAL_API_KEY: Optional. Free subscribeNewToken & subscribeMigration do not require a key.
# Only used if you enable paid/metered PumpPortal trade streams.
PUMPPORTAL_API_KEY=""

# HELIUS_API_KEY: Optional. Enables Helius Mainnet RPC & configurable Helius WebSocket program monitoring.
HELIUS_API_KEY=""

# SOLANA_RPC_URL: Optional custom Solana Mainnet-Beta RPC endpoint.
# Defaults to https://api.mainnet-beta.solana.com if HELIUS_API_KEY is not provided.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# TELEGRAM_BOT_TOKEN: Optional server-side Telegram bot token for alert dispatch.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Optional server-side Telegram chat/channel ID for alert dispatch.
TELEGRAM_CHAT_ID=""

# ADMIN_SECRET: Optional admin token for modifying collector programs & global alert rules.
# Defaults to local workspace operator mode if unset.
ADMIN_SECRET=""

# DATA_DIR: Optional persistent storage directory (e.g. /data on a Railway Volume).
# On Railway, RAILWAY_VOLUME_MOUNT_PATH is also detected automatically when attached.
DATA_DIR=""

# COLLECTOR_WORKER_URL: Required on Vercel to proxy all /api/* requests at runtime
# to your persistent Railway worker running `npm run start:worker` (worker.ts).
COLLECTOR_WORKER_URL=""

# VITE_API_BASE_URL: Optional build-time external worker URL (e.g. https://your-worker.up.railway.app).
# When set during frontend build, the browser sends REST + direct SSE /api/stream directly to the worker.
# Leave empty on Vercel to use same-origin /api/* routes proxied via COLLECTOR_WORKER_URL.
VITE_API_BASE_URL=""

